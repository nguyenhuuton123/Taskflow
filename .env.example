# Sao chép thành .env rồi chỉnh sửa (docker compose tự đọc file này)
APP_ENV=production
APP_DEBUG=false
# Tạo bằng: docker compose run --rm backend php artisan key:generate --show
# Để trống thì mỗi lần khởi động container sẽ sinh key mới
APP_KEY=
APP_URL=http://localhost:3000

DB_DATABASE=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=secret

# true: nạp dữ liệu mẫu lần đầu (chỉ khi bảng users còn trống)
DB_SEED=true
